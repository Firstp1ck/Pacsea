{
  "version": 1,
  "title": "Pacsea: Find and review Arch packages",
  "width": 1920,
  "height": 1080,
  "fps": 24,
  "framing": "full-app",
  "scenes": "scenes.html",
  "theme": {
    "accent": "#b4befe",
    "background": "#0d0e16",
    "glow": "transparent"
  },
  "allowTerms": [
    "AUR",
    "Ctrl",
    "PKGBUILD",
    "Preflight",
    "ShellCheck",
    "Namcap"
  ],
  "sourceRevision": "c2d62f9ee7ab0669f3b3b5b1754c0132e5cbae52",
  "production": {
    "interface": "Complete 116-column, 34-row native Ratatui TestBackend buffers exported as SVG. The terminal title bar and cursor treatment are recreated. Preflight is enabled for this demonstration.",
    "fixtures": "Package rows, descriptions, versions, popularity, build recipes, check outcomes, comments, vote state, history, paths and transaction sizes are illustrative. No checker, vote, package transaction or live API was run.",
    "render": "From this folder, run t3-build python render-pilot.py ~/.codex/skills/explainer-video to render with the approved score, build both excerpts and refresh the sheet. Run t3-build node check-motion.mjs ~/.codex/skills/explainer-video for the native targets, caption motion and encoded master."
  },
  "chapters": [
    {
      "start": 0,
      "title": "Package discovery and search"
    },
    {
      "start": 44,
      "title": "Compare the matches"
    },
    {
      "start": 73,
      "title": "Inspect an AUR recipe"
    },
    {
      "start": 122,
      "title": "Build the install list"
    },
    {
      "start": 179.5,
      "title": "Review your choice"
    }
  ],
